APP_NAME=经营归因分析系统
APP_ENV=development
DEBUG=true
API_PREFIX=/api
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

DATABASE_URL=mysql+aiomysql://insight:insight_password@127.0.0.1:3306/insight_agent?charset=utf8mb4
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_SOCKET_TIMEOUT_SECONDS=3

FRONTEND_BASE_URL=http://127.0.0.1:5173
OIDC_ISSUER=http://192.168.200.10:8080/realms/insight
OIDC_CLIENT_ID=insight-agent
OIDC_CLIENT_SECRET=CHANGE_ME_AFTER_KEYCLOAK_CLIENT_CREATION
OIDC_REDIRECT_URI=http://127.0.0.1:8000/auth/callback
OIDC_SCOPES=openid profile email
OIDC_STATE_TTL_SECONDS=600
OIDC_HTTP_TIMEOUT_SECONDS=10

SESSION_COOKIE_NAME=insight_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_HTTP_ONLY=true
SESSION_COOKIE_SAME_SITE=lax
SESSION_TTL_SECONDS=28800

WEBSOCKET_TOKEN_TTL_SECONDS=60
TASK_QUEUE_NAME=insight:task_queue
TASK_EVENT_CHANNEL_PREFIX=insight:task_events:
TASK_CANCEL_TTL_SECONDS=86400
TASK_WORKER_BLOCK_TIMEOUT_SECONDS=5
TASK_WORKER_REDIS_SOCKET_TIMEOUT_SECONDS=15
TASK_QUEUE_MARKER_TTL_SECONDS=300
TASK_QUEUE_RECOVERY_INTERVAL_SECONDS=30
TASK_EVENT_REPLAY_LIMIT=500
CLARIFICATION_TIMEOUT_SECONDS=86400

# Shared LLM defaults used by agents unless a dedicated profile overrides them.
MODEL_PROVIDER=openai_compatible
MODEL_NAME=
API_KEY=
BASE_URL=
MODEL_TIMEOUT_SECONDS=30

# Optional dedicated API for the analysis agent. Empty values inherit shared defaults.
ANALYSIS_AGENT_MODEL_PROVIDER=
ANALYSIS_AGENT_MODEL_NAME=
ANALYSIS_AGENT_API_KEY=
ANALYSIS_AGENT_BASE_URL=
ANALYSIS_AGENT_TIMEOUT_SECONDS=

# Optional controlled Data Agent. Without it, upload a data file in the workbench.
DATA_AGENT_BASE_URL=
DATA_AGENT_API_KEY=
DATA_AGENT_TIMEOUT_SECONDS=30
DATA_AGENT_MAX_SCANNED_ROWS=5000000
DATA_AGENT_ALLOWED_TABLES=

AGENT_DATA_ROOT=../data
AGENT_CONTEXT_MESSAGE_LIMIT=20
CONTEXT_SUMMARY_MESSAGE_THRESHOLD=30
CONTEXT_SUMMARY_CHAR_THRESHOLD=12000
CONTEXT_SUMMARY_RETAIN_MESSAGES=10
AGENT_MAX_FILE_BYTES=52428800
AGENT_MAX_ROWS=200000
AGENT_PREVIEW_ROWS=20

TRACE_ID_HEADER=X-Trace-ID
CHECK_DEPENDENCIES_ON_STARTUP=false
