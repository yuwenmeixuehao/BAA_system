# Docker Compose variables for the remote development server.
MYSQL_DATABASE=insight_agent
MYSQL_USER=insight
MYSQL_PASSWORD=change_me_mysql
MYSQL_ROOT_PASSWORD=change_me_mysql_root
MYSQL_PORT=3306

REDIS_PORT=6379
TASK_WORKER_BLOCK_TIMEOUT_SECONDS=5
TASK_WORKER_REDIS_SOCKET_TIMEOUT_SECONDS=15

# Optional OIDC provider. Enable with:
# docker compose --profile oidc up -d keycloak
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.7.0
KEYCLOAK_PUBLIC_URL=http://192.168.200.10:8080
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak_admin

# Shared LLM defaults; a dedicated analysis-agent profile may override them.
MODEL_PROVIDER=openai_compatible
MODEL_NAME=
API_KEY=
BASE_URL=
MODEL_TIMEOUT_SECONDS=30
ANALYSIS_AGENT_MODEL_PROVIDER=
ANALYSIS_AGENT_MODEL_NAME=
ANALYSIS_AGENT_API_KEY=
ANALYSIS_AGENT_BASE_URL=
ANALYSIS_AGENT_TIMEOUT_SECONDS=

# Controlled Data Agent adapter; the application never connects to a business DB directly.
DATA_AGENT_BASE_URL=
DATA_AGENT_API_KEY=
DATA_AGENT_TIMEOUT_SECONDS=30
DATA_AGENT_MAX_SCANNED_ROWS=5000000
# Optional comma-separated SQL table allowlist, for example: sales_fact,dim_product
DATA_AGENT_ALLOWED_TABLES=
AGENT_DATA_ROOT=../data
AGENT_MAX_FILE_BYTES=52428800
AGENT_MAX_ROWS=200000
AGENT_PREVIEW_ROWS=20
CONTEXT_SUMMARY_MESSAGE_THRESHOLD=30
CONTEXT_SUMMARY_CHAR_THRESHOLD=12000
CONTEXT_SUMMARY_RETAIN_MESSAGES=10
